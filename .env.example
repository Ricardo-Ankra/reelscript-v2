# =============================================================================
# Reelscript V2 — environment configuration
# Copy to .env.local and fill in. .env.local is gitignored.
# =============================================================================

# -----------------------------------------------------------------------------
# REQUIRED for Phase 0 (the app shell + auth + RLS)
# -----------------------------------------------------------------------------
# Supabase's newer API keys: publishable (sb_publishable_…) for the browser,
# secret (sb_secret_…) for server-only use. Local stack: values are printed by
# `npx supabase start`. Hosted: dashboard → Project Settings → API Keys.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Full access, bypasses RLS — never expose to the client. Used by
# the RLS verification script now, and by the Inngest worker from Phase 1 on.
SUPABASE_SECRET_KEY=

# Direct Postgres connection, used only by the RLS verification script's
# structural catalog query (npm run verify:rls).
#   Local stack: postgresql://postgres:postgres@127.0.0.1:54322/postgres
#   Hosted:      Supabase dashboard → Connect → "Direct connection" string
SUPABASE_DB_URL=

# -----------------------------------------------------------------------------
# PROVISION NOW, WIRED IN A LATER PHASE
# Fill these as you create the accounts; the app does not read them until the
# phase noted. Keeping them here means you set each external account up once.
# -----------------------------------------------------------------------------

# Cloudflare R2 (Phase 1) — S3-compatible object storage.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=

# Inngest (Phase 1) — orchestration.
# Local dev: set INNGEST_DEV=1 so the SDK runs in dev mode (no signing key);
# without it the dev server gets 500s ("cloud mode, no signing key"). The event/
# signing keys stay blank locally and are set on Vercel for production.
INNGEST_DEV=1
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# AWS / Remotion Lambda (Phase 1) — rendering. Region matches Supabase (eu-central-1).
REMOTION_AWS_ACCESS_KEY_ID=
REMOTION_AWS_SECRET_ACCESS_KEY=
AWS_REGION=
# Produced by `npm run deploy:remotion`; paste the printed values back here.
REMOTION_LAMBDA_FUNCTION_NAME=
REMOTION_SERVE_URL=

# AI + audio providers. In early (seeded) phases these are read from env; from
# Phase 8 they move into the encrypted api_credentials table (per-account).
ANTHROPIC_API_KEY=          # Phase 2
ELEVENLABS_API_KEY=         # Phase 3
OPENAI_API_KEY=             # Phase 4 (optional)
PEXELS_API_KEY=             # Phase 5 (optional)
PIXABAY_API_KEY=            # Phase 5 (optional)
